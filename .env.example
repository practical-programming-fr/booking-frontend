# URL of the booking-backend service
BOOKING_API_URL=http://localhost:8787
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:8787

# Marketing site — used for the "Back to flylo-air.com" link in the header
NEXT_PUBLIC_MARKETING_URL=https://www.flylo-air.com

# Supabase — currently used only for future realtime hooks
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Incident orchestrator (the "3am outage" demo). All optional in local dev:
# with none of these set, the ops API routes are open, the backend ops API is
# open, agents are simulated, and Slack posts are logged to the server console.
# ---------------------------------------------------------------------------

# Password gate for the ops API routes (/api/ops/*). When unset, they are open
# (local dev only).
# OPS_DASHBOARD_PASSWORD=

# Shared secret for booking-backend /v1/_ops/* (must match the backend's
# OPS_SHARED_SECRET). Required in production so ops calls are authenticated.
# OPS_SHARED_SECRET=

# Slack incoming webhook for #flylo. Incident pings/summaries/PR links post
# here. When unset, posts are logged to the server console.
# SLACK_WEBHOOK_URL=

# Cursor API key for launching cloud agents (summarizer + fixer). When unset,
# the orchestrator runs in simulated mode (canned summary, no real PR).
# CURSOR_API_KEY=
# Optional: pin the agent model. Defaults to the account's default model.
# OPS_AGENT_MODEL=

# GitHub token used to label the agent's fix PR `demo` (so the nightly cleanup
# workflow can close it). Repo write access to the fix repo. Optional.
# GITHUB_TOKEN=

# Repo the fix agent works on. Defaults to flylo-air/booking-backend.
# OPS_FIX_REPO=flylo-air/booking-backend

# Cron secret for the /api/ops/tick endpoint. Vercel Cron sends it as a bearer
# token so the minute-by-minute orchestrator tick runs unattended.
# CRON_SECRET=

# Safety net: minutes before a left-on outage flag auto-flips off. Default 20,
# 0 disables auto-expiry.
# OUTAGE_TTL_MINUTES=20

# Optional request header carrying the identity of whoever flips the toggle
# (e.g. an SSO-forwarded email), recorded as the "flipped by" attribution.
# Unset = no attribution (fine when there is no SSO in front of the ops routes).
# OPS_ACTOR_HEADER=

# ---------------------------------------------------------------------------
# Per-session ("scoped") demo outage: the /ops Ops Console. A presenter breaks
# the site for their own browser only. Everything below is optional locally; the
# console gate is open with no password, and a scoped outage can only actually
# be triggered once OPS_SHARED_SECRET + the backend are configured.
# ---------------------------------------------------------------------------

# Slack bot token (xoxb-...) for routing each session's incident to that
# presenter's own channel via the Slack Web API (chat.postMessage). Needs the
# chat:write scope. When unset, posting falls back to the single SLACK_WEBHOOK_URL
# channel and notes the intended channel in the message text.
# SLACK_BOT_TOKEN=

# Optional: allow the orchestrator to auto-create a Slack channel by name when a
# session asks for one that does not exist. Needs the channels:manage scope on
# the bot token. Default OFF. Set to 1/true to enable.
# SLACK_AUTO_CREATE_CHANNEL=

# Minutes a scoped demo outage lives before it self-heals on both the backend
# and the browser cookie. Default 20.
# DEMO_SESSION_TTL_MINUTES=20

# Cookie domain for the demo session id. Defaults to ".flylo-air.com" so it is
# shared across *.flylo-air.com, and is only applied when the request host ends
# with flylo-air.com (localhost / previews stay host-only). Set to empty to
# force host-only everywhere.
# DEMO_SESSION_COOKIE_DOMAIN=.flylo-air.com

# Optional crew NOC base URL. When set, the console links a presenter to their
# session in the NOC as <url>?demo=<sessionId>.
# CREW_NOC_URL=
# NEXT_PUBLIC_CREW_NOC_URL=
