# URL of the booking-backend service
BOOKING_API_URL=http://localhost:8787
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:8787

# Marketing site — used for the "Back to flylo-air.com" link in the header
NEXT_PUBLIC_MARKETING_URL=https://www.flylo-air.com

# Supabase — currently used only for future realtime hooks
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Ops incident console (the "3am outage" demo). All optional in local dev:
# with none of these set, /ops is open, the backend ops API is open, agents
# are simulated, and Slack posts are logged to the server console.
# ---------------------------------------------------------------------------

# Password gate for /ops. When unset, the console is open (local dev only).
# OPS_DASHBOARD_PASSWORD=

# Shared secret for booking-backend /v1/_ops/* (must match the backend's
# OPS_SHARED_SECRET). Required in production so ops calls are authenticated.
# OPS_SHARED_SECRET=

# Slack incoming webhook for #flylo. Incident pings/summaries/PR links post
# here. When unset, posts are logged to the server console.
# SLACK_WEBHOOK_URL=

# Cursor API key for launching cloud agents (summarizer + fixer). When unset,
# the console runs in simulated mode (canned summary, no real PR).
# CURSOR_API_KEY=
# Optional: pin the agent model. Defaults to the account's default model.
# OPS_AGENT_MODEL=

# GitHub token used to label the agent's fix PR `demo` (so the nightly cleanup
# workflow can close it). Repo write access to the fix repo. Optional.
# GITHUB_TOKEN=

# Repo the fix agent works on. Defaults to flylo-air/booking-backend.
# OPS_FIX_REPO=flylo-air/booking-backend

# Cron secret for the /api/ops/tick endpoint. Vercel Cron sends it as a bearer
# token so the minute-by-minute orchestrator tick runs unattended.
# CRON_SECRET=

# Safety net: minutes before a left-on outage flag auto-flips off. Default 20,
# 0 disables auto-expiry.
# OUTAGE_TTL_MINUTES=20

# Optional request header carrying the identity of whoever flips the toggle
# (e.g. an SSO-forwarded email), shown in the "flipped by" banner. Unset = no
# attribution (fine when there is no SSO in front of the console).
# OPS_ACTOR_HEADER=
